{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/NHKRoku/nginx-arm64-module-registry/main/catalog/module-index.schema.json",
  "title": "NGINX Dynamic Module Registry",
  "type": "object",
  "required": ["name", "description", "schema_version", "generated_at", "architecture", "os_family", "modules"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "architecture": { "const": "arm64" },
    "os_family": { "type": "array", "items": { "type": "string" } },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "version", "type", "repository", "source", "binaries"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "version": { "type": "string" },
          "type": { "const": "dynamic" },
          "repository": { "type": "string", "format": "uri" },
          "source": { "$ref": "#/$defs/artifact" },
          "binaries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binary" } }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["filename", "download_url", "sha256"],
      "properties": {
        "filename": { "type": "string" },
        "download_url": { "type": ["string", "null"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "binary": {
      "type": "object",
      "required": ["os", "debian_release", "architecture", "nginx_version", "build_flavor", "filename", "download_url", "sha256"],
      "properties": {
        "os": { "const": "debian" },
        "debian_release": { "type": "string" },
        "architecture": { "const": "arm64" },
        "nginx_version": { "type": "string" },
        "build_flavor": { "type": "string" },
        "filename": { "type": "string" },
        "download_url": { "type": ["string", "null"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
